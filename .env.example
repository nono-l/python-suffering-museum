# Copy to .env / set in Vercel project settings for production.

# Neon Postgres connection string (optional in preview — falls back to PGLite).
# Required for multi-visitor shared counters / board in production.
DATABASE_URL=

# Public hostname of the deployed site (no protocol). Enables OG/Twitter card image URLs.
# Example: python-suffering-museum.vercel.app
VITE_PUBLIC_HOSTNAME=

# Better Auth secret (generate a long random string for production).
BETTER_AUTH_SECRET=

# OAuth (optional — board login). Leave unset to hide providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
